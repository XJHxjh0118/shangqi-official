# 本地默认 SQLite（与 prisma/schema.prisma provider=sqlite 一致）
DATABASE_URL="file:./dev.db"

# 若改用 MySQL：
# DATABASE_URL="mysql://user:pass@127.0.0.1:3306/official_site"
# 并把 prisma/schema.prisma 的 provider 改为 mysql

JWT_SECRET="change-me-jwt-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3001
UPLOAD_DIR=uploads
# 浏览器可访问的 API 根地址（无 /api 后缀），用于拼接上传资源 URL
PUBLIC_BASE_URL=http://127.0.0.1:3001

# 跨域白名单（逗号分隔）。生产 Docker 部署见项目根 .env.production.example
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- 可选：咨询/留言通知 ----
# Webhook（JSON POST，body: { subject, text }）
# NOTIFY_WEBHOOK_URL=https://example.com/hook

# SMTP（与 NOTIFY_TO 同时配置时启用邮件通知）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# NOTIFY_TO=ops@example.com
