# 复制为 .env.production 后修改，再执行：
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# ---- 对外访问地址（浏览器能打开的 URL，不要带尾部斜杠）----
# 服务器 IP 部署示例：
NUXT_PUBLIC_SITE_URL=http://YOUR_SERVER_IP:3000
NUXT_PUBLIC_API_BASE=http://YOUR_SERVER_IP:3001/car
PUBLIC_BASE_URL=http://YOUR_SERVER_IP:3001

# 域名部署示例（HTTPS 由外层 Nginx/Caddy 终结）：
# NUXT_PUBLIC_SITE_URL=https://www.example.com
# NUXT_PUBLIC_API_BASE=https://api.example.com/car
# PUBLIC_BASE_URL=https://api.example.com

# 允许 @nuxt/image 优化的远程图域名（逗号分隔，不含协议）
NUXT_IMAGE_DOMAINS=YOUR_SERVER_IP,localhost,127.0.0.1

# API 跨域白名单（必须包含官网域名/端口）
CORS_ORIGINS=http://YOUR_SERVER_IP:3000

# ---- 端口映射（宿主机端口）----
WEB_PORT=3000
API_PORT=3001
ADMIN_PORT=8080

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=official_site
MYSQL_USER=site
MYSQL_PASSWORD=change-me-site

# ---- JWT（务必改成随机长字符串）----
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# 首次部署写入示例数据（admin/admin123）；上线后改为 false
RUN_DB_SEED=true

# ---- 可选：咨询/留言通知（写入 api 容器环境）----
# NOTIFY_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# NOTIFY_TO=
