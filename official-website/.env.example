# 站点对外 URL（SEO / i18n / canonical）
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# 站点显示名（SEO / Schema）
NUXT_PUBLIC_SITE_NAME=上汽经创

# 站点描述
NUXT_PUBLIC_SITE_DESCRIPTION=上汽系原厂附件门户：MG、荣威、智己装车配件与经销商询盘。

# 公开 API 前缀（需浏览器可访问，含 /car）
# Windows 建议用 127.0.0.1，避免 localhost 解析到 ::1 连错进程
NUXT_PUBLIC_API_BASE=http://127.0.0.1:3001/car

# API 请求超时（毫秒）
NUXT_PUBLIC_API_TIMEOUT_MS=12000

# @nuxt/image 允许的远程图域名（逗号分隔，不含协议）
NUXT_IMAGE_DOMAINS=localhost,127.0.0.1,images.unsplash.com

# Optional: Google Analytics Measurement ID, e.g. G-XXXXXXXXXX
NUXT_PUBLIC_GTAG_ID=
